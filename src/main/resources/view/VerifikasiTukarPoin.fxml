<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="1024.0" prefWidth="1440.0" styleClass="root-pane" stylesheets="@verifikasitukarpoin.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.VerifikasiTukarPoinController">

    <HBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        
        <VBox alignment="TOP_CENTER" prefWidth="320.0" styleClass="sidebar">
            <padding>
                <Insets bottom="50.0" left="30.0" right="30.0" top="50.0" />
            </padding>
            
            <VBox alignment="CENTER" minHeight="120.0" prefWidth="240.0" styleClass="sidebar-title-box">
                <Label styleClass="sidebar-title-text" text="Tukar Poin" />
            </VBox>
        </VBox>

        <AnchorPane HBox.hgrow="ALWAYS">
            
            <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                
                <VBox fx:id="formContainer" alignment="CENTER" maxWidth="900.0" spacing="30.0">
                    
                    <Label styleClass="title-verifikasi" text="Verifikasi" />

                    <TextField fx:id="tfInput1" prefHeight="80.0" promptText="" styleClass="input-field-bar" />
                    
                    <TextField fx:id="tfInput2" prefHeight="80.0" promptText="" styleClass="input-field-bar">
                        <VBox.margin>
                            <Insets bottom="40.0" />
                        </VBox.margin>
                    </TextField>

                    <HBox alignment="CENTER" spacing="150.0">
                        
                        <VBox alignment="CENTER" spacing="10.0">
                            <Label styleClass="label-poin" text="Jumlah Poin" />
                            <Button fx:id="btnSetuju" prefHeight="70.0" prefWidth="220.0" styleClass="btn-action" text="Setuju" />
                        </VBox>

                        <VBox alignment="CENTER" spacing="10.0">
                            <Label styleClass="label-poin" text="Jumlah Poin" />
                            <Button fx:id="btnBatalkan" prefHeight="70.0" prefWidth="220.0" styleClass="btn-action, btn-cancel" text="Batalkan" />
                        </VBox>

                    </HBox>

                </VBox>

            </StackPane>

        </AnchorPane>

    </HBox>

</AnchorPane>
