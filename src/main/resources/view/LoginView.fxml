<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" styleClass="root" stylesheets="@../css/login-style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginController">
    <children>

        <VBox alignment="CENTER_LEFT" prefWidth="500.0" style="-fx-background-color: white;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="500.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox fx:id="formContainer" alignment="CENTER_LEFT" spacing="15.0">
                    <padding>
                        <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
                    </padding>

                    <Label styleClass="header-title" text="Hello, Admin!">
                        <font>
                            <Font name="System Bold" size="28.0" />
                        </font>
                    </Label>
                    <Label styleClass="sub-title" text="Silakan masuk untuk mengelola sampah." />

                    <Region prefHeight="20.0" />

                    <Label styleClass="field-label" text="USERNAME" />
                    <TextField fx:id="usernameField" prefHeight="45.0" promptText="Masukkan username Anda" />

                    <Label styleClass="field-label" text="PASSWORD" />
                    <PasswordField fx:id="passwordField" prefHeight="45.0" promptText="Masukkan kata sandi" />

                    <HBox alignment="CENTER_LEFT">
                        <CheckBox fx:id="rememberCheckBox" mnemonicParsing="false" text="Ingat Saya" textFill="#6b7280" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Hyperlink onAction="#handleForgotPassword" style="-fx-font-size: 12px;" text="Lupa Password?" />
                    </HBox>

                    <Region prefHeight="10.0" />
                    <Label fx:id="errorLabel" styleClass="error-label" text="" wrapText="true" />

                    <Button fx:id="loginButton" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin" prefHeight="50.0" styleClass="login-btn" text="LOGIN">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Button>

                    <HBox alignment="CENTER" spacing="5.0">
                        <Label text="Belum punya akun?" textFill="#6b7280" />
                        <Hyperlink onAction="#handleRegister" text="Daftar Sekarang" />
                        <padding>
                            <Insets top="10.0" />
                        </padding>
                    </HBox>
                </VBox>
            </children>
        </VBox>

        <Region maxHeight="300.0" maxWidth="300.0" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 50%;" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="-50.0" />

        <ImageView fitHeight="725.0" fitWidth="340.0" layoutY="-0.6666666666666666" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="-68.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="-1.0">
            <image>
                <Image url="@../image/login.png" />
            </image>
        </ImageView>

        <ImageView fitHeight="607.0" fitWidth="539.0" layoutX="488.0" layoutY="70.0" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="1.3333333333333712" AnchorPane.rightAnchor="-27.0" AnchorPane.topAnchor="70.0">
            <image>
                <Image url="@../image/maskot.png" />
            </image>
            <effect>
                <DropShadow color="#00000033" height="40.0" radius="19.5" width="40.0" />
            </effect>
            <viewport>
                <Rectangle2D />
            </viewport>
        </ImageView>

    </children>
</AnchorPane>
