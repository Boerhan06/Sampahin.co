<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane 
    xmlns="http://javafx.com/javafx/17" 
    xmlns:fx="http://javafx.com/fxml/1" 
    fx:controller="controller.DashboardController"
    prefHeight="600.0" prefWidth="800.0"
    stylesheets="@styles.css">

    <left>
        <VBox spacing="10" styleClass="sidebar" prefWidth="200">
            <padding>
                <Insets top="20" right="10" bottom="20" left="10"/>
            </padding>
            
            <Label text="MENU UTAMA" style="-fx-font-weight: bold; -fx-text-fill: #4A148C;"/>
            
            <Button text="Data Sampah" maxWidth="Infinity" style="-fx-background-color: #D1C4E9;"/>
            <Button text="Transaksi" maxWidth="Infinity" style="-fx-background-color: transparent;"/>
            <Button text="Logout" maxWidth="Infinity" style="-fx-background-color: #FFCDD2; -fx-text-fill: red;"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Daftar Harga Sampah" styleClass="header-label"/>

            <TableView fx:id="tabelSampah" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="kolomID" text="ID" prefWidth="50.0" />
                    <TableColumn fx:id="kolomJenis" text="Jenis Sampah" prefWidth="200.0" />
                    <TableColumn fx:id="kolomKategori" text="Kategori" prefWidth="100.0" />
                    <TableColumn fx:id="kolomHarga" text="Harga (Poin/Kg)" prefWidth="150.0" />
                </columns>
            </TableView>
            
            <Button text="Refresh Data" onAction="#loadDataDariDB"/>
        </VBox>
    </center>

</BorderPane>