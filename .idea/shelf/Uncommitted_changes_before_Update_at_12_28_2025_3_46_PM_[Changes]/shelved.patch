+/* --- PALET WARNA --- */
+* {
+    -fx-bg-color: #F9FAF4;      /* Background Utama */
+    -fx-purple-dark: #685BAB;   /* Ungu Gelap (Card Grafik) */
+    -fx-purple-mid: #7B70B4;    /* Ungu Medium (Card Poin) */
+    -fx-purple-light: #9C90D9;  /* Ungu Terang (Badge/Banner) */
+    -fx-white: #FFFFFF;
+    -fx-font-family: 'Segoe UI', sans-serif;
+}
+
+.root-pane {
+    -fx-background-color: -fx-bg-color;
+}
+
+/* --- SIDEBAR (Konsisten dengan project) --- */
+.sidebar {
+    -fx-background-color: -fx-purple-dark;
+    -fx-background-radius: 0 35 35 0;
+    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 0);
+}
+
+.sidebar-btn {
+    -fx-background-color: transparent;
+    -fx-text-fill: #B8B0E0;
+    -fx-font-size: 24px;
+    -fx-cursor: hand;
+}
+
+.sidebar-btn-active {
+    -fx-background-color: -fx-white;
+    -fx-text-fill: -fx-purple-dark;
+    -fx-background-radius: 15;
+    -fx-min-width: 50;
+    -fx-min-height: 50;
+    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);
+}
+
+/* --- BADGE "DETAIL PENGGUNA" (Kanan Atas) --- */
+.header-badge {
+    -fx-background-color: rgba(156, 144, 217, 0.4); /* #9C90D9 Transparan */
+    -fx-background-radius: 15;
+    -fx-text-fill: black;
+    -fx-font-weight: bold;
+    -fx-font-size: 16px;
+    -fx-padding: 10 30 10 30;
+    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 2);
+}
+
+/* --- BANNER "NAMA PENGGUNA" (Tengah) --- */
+.name-banner {
+    -fx-background-color: rgba(156, 144, 217, 0.4); /* #9C90D9 Transparan */
+    -fx-background-radius: 15 15 0 0; /* Melengkung atas saja (opsional) atau full */
+    -fx-background-radius: 15;
+    -fx-padding: 15;
+    -fx-alignment: CENTER;
+}
+
+.name-text {
+    -fx-text-fill: #4A4A4A; /* Abu gelap agar kontras */
+    -fx-font-weight: bold;
+    -fx-font-size: 24px;
+}
+
+/* --- KARTU UMUM --- */
+.info-card {
+    -fx-background-radius: 20;
+    -fx-padding: 20;
+    -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 5);
+}
+
+/* Kartu Kiri: Total Poin (Ungu Medium) */
+.card-poin {
+    /* Gradasi dari #9C90D9 ke #7B70B4 */
+    -fx-background-color: linear-gradient(to bottom right, #9C90D9, #7B70B4);
+}
+
+/* Kartu Kanan: Grafik (Ungu Gelap) */
+.card-grafik {
+    /* Gradasi dari #7B70B4 ke #685BAB */
+    -fx-background-color: linear-gradient(to bottom right, #7B70B4, #685BAB);
+}
+
+.card-title {
+    -fx-text-fill: white;
+    -fx-font-size: 20px;
+    -fx-font-weight: bold;
+}
+
+.poin-value {
+    -fx-text-fill: white;
+    -fx-font-size: 48px; /* Angka Besar */
+    -fx-font-weight: bold;
+}
+
+.poin-sub {
+    -fx-text-fill: #E0E0E0;
+    -fx-font-size: 14px;
+}
+
+/* --- STYLING GRAFIK (JavaFX Chart) --- */
+.chart-bar {
+    -fx-bar-fill: rgba(255,255,255,0.8); /* Batang grafik putih transparan */
+}
+.axis {
+    -fx-tick-label-fill: white; /* Angka sumbu putih */
+}
+.axis-label {
+    -fx-text-fill: white;
+}
+.chart-plot-background {
+    -fx-background-color: transparent;
+}
+.chart-vertical-grid-lines, .chart-horizontal-grid-lines {
+    -fx-stroke: rgba(255,255,255,0.1); /* Garis grid tipis */
+}
