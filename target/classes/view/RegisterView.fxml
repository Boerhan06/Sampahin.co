<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" styleClass="root" stylesheets="@../css/login-style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RegisterController">
    <children>

        <StackPane layoutX="500.0" prefHeight="600.0" prefWidth="500.0" styleClass="right-panel" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />

        <VBox alignment="CENTER_LEFT" prefWidth="500.0" style="-fx-background-color: white;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <VBox fx:id="formContainer" alignment="CENTER_LEFT" spacing="8.0">
                    <padding>
                        <Insets bottom="20.0" left="50.0" right="50.0" top="20.0" />
                    </padding>

                    <Label styleClass="header-title" text="Registrasi (Tahap 1)">
                        <font>
                            <Font name="System Bold" size="28.0" />
                        </font>
                    </Label>
                    <Label styleClass="sub-title" text="Lengkapi data diri Anda terlebih dahulu." />

                    <Region prefHeight="10.0" />

                    <Label styleClass="field-label" text="NAMA LENGKAP" />
                    <TextField fx:id="namaField" prefHeight="45.0" promptText="Masukkan nama lengkap" styleClass="input-field" />

                    <Label styleClass="field-label" text="EMAIL" />
                    <TextField fx:id="emailField" prefHeight="45.0" promptText="alamat@email.com" styleClass="input-field" />

                    <Label styleClass="field-label" text="NO TELEPON" />
                    <TextField fx:id="telpField" prefHeight="45.0" promptText="Contoh: 08123456789" styleClass="input-field" />

                    <Label styleClass="field-label" text="ALAMAT" />
                    <TextField fx:id="alamatField" prefHeight="45.0" promptText="Masukkan alamat domisili" styleClass="input-field" />

                    <Region prefHeight="15.0" />

                    <Label fx:id="errorLabel" styleClass="error-label" text="" wrapText="true" />

                    <Button fx:id="btnLanjut" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLanjut" prefHeight="50.0" styleClass="login-btn" text="LANJUT KE TAHAP 2 →">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Button>

                    <HBox alignment="CENTER" spacing="5.0">
                        <Label text="Sudah punya akun?" textFill="#6b7280" />
                        <Hyperlink fx:id="linkLogin" onAction="#handleBackToLogin" styleClass="hyperlink" text="Login Disini" />
                        <padding>
                            <Insets top="10.0" />
                        </padding>
                    </HBox>
                </VBox>
            </children>
        </VBox>

        <Region maxHeight="300.0" maxWidth="300.0" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 50%;" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="-50.0" />

        <ImageView fitHeight="500.0" fitWidth="500.0" layoutX="551.0" layoutY="172.0" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="-16.0" AnchorPane.rightAnchor="-12.0" AnchorPane.topAnchor="172.0">
            <image>
                <Image url="@../image/maskot.png" />
            </image>
            <effect>
                <DropShadow color="#00000033" height="40.0" radius="19.5" width="40.0" />
            </effect>
            <viewport>
                <Rectangle2D />
            </viewport>
        </ImageView>

    </children>
</AnchorPane>